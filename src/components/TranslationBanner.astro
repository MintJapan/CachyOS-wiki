---
import DefaultBanner from '@astrojs/starlight/components/Banner.astro';

const { locale, entry, isFallback } = Astro.locals.starlightRoute;

if (!locale || isFallback) return null;

const aiTranslated = entry.data.ai_translated ?? false;

const hasOutdatedBanner = !!entry.data.banner;

const title = Astro.locals.t('banner.translation.title');
const line1 = Astro.locals.t('banner.translation.line1');
const line2 = Astro.locals.t('banner.translation.line2');
const line3 = Astro.locals.t('banner.translation.line3');
---

{hasOutdatedBanner && <DefaultBanner />}

<div id="translation-banner" class="sl-banner" data-pagefind-ignore lang={locale} data-ai={String(aiTranslated)} style="display: none;">
  <div class="sl-banner-content">
    <strong>{title}</strong>
    <p>{line1}</p>
    {aiTranslated && (
      <p>{line2}</p>
    )}
    <p>{line3}</p>
  </div>
  <button
    type="button"
    class="sl-dismiss-btn"
    aria-label="Dismiss banner"
    onclick={`sessionStorage.setItem('banner_dismissed_translation_' + (${aiTranslated} ? 'ai' : 'manual'), 'true');document.getElementById('translation-banner').style.display='none';`}
  >×</button>
</div>

<style>
  .sl-banner {
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg);
    border-bottom: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-text);
    font-size: 0.8125rem;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    position: sticky;
    top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    z-index: 100;
  }
  .sl-banner-content {
    max-width: 90%;
  }
  .sl-banner-content strong {
    display: block;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: var(--sl-color-accent);
  }
  .sl-banner-content p {
    margin: 0.25rem 0;
    line-height: 1.5;
  }
  .sl-dismiss-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: none;
    border: none;
    color: var(--sl-color-text-muted);
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    opacity: 0.6;
    transition: opacity 0.15s;
    padding: 0.25rem;
  }
  .sl-dismiss-btn:hover {
    opacity: 1;
  }
</style>

<script is:inline>
  (function() {
    const banner = document.getElementById('translation-banner');
    if (!banner) return;
    const ai = banner.dataset.ai === 'true';
    const key = 'banner_dismissed_translation_' + (ai ? 'ai' : 'manual');
    if (!sessionStorage.getItem(key)) banner.style.display = '';
  })();
</script>
